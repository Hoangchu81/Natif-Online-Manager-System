PORT=3001
NODE_ENV=development

# CRITICAL: Must be set in production (see .env.production)
JWT_SECRET=your_jwt_secret_key_here_min_32_chars
JWT_EXPIRES=7d

# Database (uses DB_* vars — NOT DATABASE_URL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=natif_online_manager
DB_USER=postgres
DB_PASSWORD=postgres

# API
API_URL=http://localhost:3001
FRONTEND_URL=https://oms.natif.vn

# Production env vars (set on VPS)
# NODE_ENV=production
# TEST_DB_NAME=natif_online_manager_test
