PORT=3001
NODE_ENV=development

# CRITICAL: Must be set in production (see .env.production)
JWT_SECRET=your_jwt_secret_key_here_min_32_chars
JWT_EXPIRES=7d

# Database (uses DB_* vars — NOT DATABASE_URL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=natif_online_manager
DB_USER=postgres
DB_PASSWORD=postgres

# API
API_URL=http://localhost:3001
FRONTEND_URL=https://oms.natif.vn

# Production env vars (set on VPS)
# NODE_ENV=production
# TEST_DB_NAME=natif_online_manager_test

# ─── Email: Google SMTP (primary) ───────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@natif.vn
SMTP_PASS=your-google-app-password
SMTP_FROM=noreply@natif.vn
SMTP_FROM_NAME=NATIF OMS

# ─── Email: Resend API (fallback) ───────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=noreply@natif.vn
EMAIL_FROM_NAME=NATIF OMS
